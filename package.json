{
  "name": "faq-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next build",
    "start": "next start -p 3005",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:production": "eslint --config eslint.config.production.mjs",
    "type-check": "tsc --noEmit",
    "analyze": "ANALYZE=true next build",
    "export": "next export"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-react": "^12.0.0",
    "@sentry/nextjs": "^10.71.0",
    "ckeditor5": "49.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sweetalert2": "^11.23.0",
    "swiper": "^14.2.0",
    "typescript": "^5",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.5",
    "fast-uri": "3.1.8",
    "source-map-js": "1.2.2",
    "lodash": "4.18.0",
    "lodash-es": "4.18.0",
    "flatted": "3.4.2",
    "@humanfs/node": "0.16.8",
    "mdast-util-to-hast@^13": "13.2.1",
    "nanoid@^3": "3.3.20",
    "form-data@^3": "3.0.5",
    "js-yaml@^4": "4.3.2",
    "ws@^7": "7.5.13",
    "@tootallnate/once": "2.0.1",
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^2": "2.1.7",
    "brace-expansion@^5": "5.0.12",
    "minimatch@^3": "3.1.5",
    "minimatch@^9": "9.0.9",
    "picomatch@^2": "2.3.2",
    "picomatch@^4": "4.0.7",
    "glob@^10": "10.5.0",
    "postcss-selector-parser": "7.1.6",
    "ajv@^6": "6.14.0",
    "yaml@^2": "2.8.3"
  }
